package views

import (
    "github.com/CypherGoat/web/cmd/api"
    "strings"
    "fmt"
)

templ BridgeTransactionPage(tx1, tx2 api.Transaction, quote api.BridgeQuote, bridgeGroupID string) {
@Header() {
    <style>
    body {
        background-color: #0b0d14;
        color: #e0e0e0;
        font-family: 'Inter', 'Segoe UI', 'Arial', sans-serif;
        min-height: 100vh;
    }

    .bridge-tx-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        min-height: 100vh;
        padding: 2.5rem 1rem 4rem;
        background: #121520;
    }

    .bridge-tx-title-row {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.75rem;
        text-align: center;
    }

    .bridge-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.12);
        border: 1px solid rgba(99, 102, 241, 0.28);
        color: #a5b4fc;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .bridge-tx-heading {
        font-size: 1.8rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .bridge-tx-subtitle {
        color: #a0a0a0;
        font-size: 0.9rem;
        max-width: 540px;
    }

    .bridge-summary-bar {
        width: 100%;
        max-width: 720px;
        background: rgba(99, 102, 241, 0.06);
        border: 1px solid rgba(99, 102, 241, 0.18);
        border-radius: 16px;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .bridge-summary-label {
        color: #a0a0a0;
        font-size: 0.9rem;
    }

    .bridge-summary-value {
        color: #a5b4fc;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .bridge-main-card {
        width: 100%;
        max-width: 720px;
        margin-bottom: 1.25rem;
    }

    .transaction-card {
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0.008)),
            #11151c;
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: box-shadow 0.3s ease;
    }

    .transaction-card:hover {
        box-shadow: 0 34px 86px rgba(0, 0, 0, 0.38);
    }

    .transaction-card.secondary-card {
        padding: 1.25rem 1.5rem;
        box-shadow: none;
        opacity: 0.85;
    }

    .leg-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #798192;
        margin-bottom: 0.6rem;
    }

    .transaction-header {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 1.25rem;
    }

    .secondary-card .transaction-header {
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
    }

    .transaction-section {
        margin-bottom: 1.25rem;
    }

    .section-label {
        color: #a0a0a0;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.3rem;
    }

    .section-value {
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 600;
        word-break: break-all;
    }

    .code-block {
        background: rgba(0, 0, 0, 0.15);
        border-radius: 8px;
        padding: 0.8rem;
        font-family: 'Courier New', monospace;
        color: #e0e0e0;
        border: 1px solid #1e2235;
        word-break: break-all;
        overflow-wrap: break-word;
        font-size: 0.85rem;
    }

    .qr-toggle-btn {
        color: #ece6d8;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 8px;
        padding: 0.5rem 1rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .qr-toggle-btn svg {
        margin-right: 0.5rem;
        vertical-align: middle;
    }

    .qr-toggle-btn:hover {
        background: rgba(255, 255, 255, 0.07);
    }

    .divider {
        height: 1px;
        background: linear-gradient(to right, rgba(255,255,255,0.05), rgba(255,255,255,0.1), rgba(255,255,255,0.05));
        margin: 1.25rem 0;
    }

    .cgid-value {
        font-family: 'Courier New', monospace;
        font-size: 0.95rem;
        color: #ffffff;
    }

    .track-link {
        color: #e9e2d1;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .track-link:hover {
        color: #faf7ef;
        text-decoration: underline;
    }

    .auto-tag {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        font-size: 0.68rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-left: 0.5rem;
    }

    .warning-box {
        width: 100%;
        max-width: 720px;
        background: rgba(99, 102, 241, 0.08);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 14px;
        padding: 1rem 1.25rem;
        color: #dde0f7;
        font-size: 0.88rem;
        line-height: 1.55;
    }
    </style>

    <div class="bridge-tx-wrap">
        <div class="bridge-tx-title-row">
            <div class="bridge-header-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"></path></svg>
                Private Route
            </div>
            <h1 class="bridge-tx-heading">Private Route Trade Created</h1>
            <a href="/saferoute" style="font-size:0.78rem;color:#a5b4fc;text-decoration:none;opacity:0.65;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.65'">Learn how Private Route works →</a>
            <p class="bridge-tx-subtitle">Deposit into the address below. Your trade automatically routes through XMR on a second exchange — no separate deposit needed.</p>
        </div>

        <div class="bridge-summary-bar">
            <span class="bridge-summary-label">You'll receive ≈</span>
            <span class="bridge-summary-value">{ FormatFloat(quote.EstimatedReceive) } { strings.ToUpper(tx2.Coin2) }</span>
        </div>

        <div class="bridge-main-card">
            <div class="transaction-card">
                <div class="leg-label">Leg 1 — Deposit Here</div>
                <h2 class="transaction-header">{ tx1.Provider }</h2>

                <div class="transaction-section">
                    <div class="section-label">You Send</div>
                    <div class="section-value">{ FormatFloat(quote.Leg1.SendAmount) } { strings.ToUpper(tx1.Coin1) }</div>
                </div>

                <div class="transaction-section">
                    <div class="section-label">Routes To ≈</div>
                    <div class="section-value">{ FormatFloat(quote.Leg1.ReceiveAmount) } XMR</div>
                </div>

                <div class="transaction-section">
                    <div class="section-label">Deposit Address</div>
                    <div class="code-block">{ tx1.Address }</div>
                </div>

                if tx1.Memo != "" {
                    <div class="transaction-section">
                        <div class="section-label">Memo <span style="background:rgba(220,38,38,0.2);color:#ef4444;font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:4px;font-weight:600;margin-left:0.5rem;text-transform:uppercase;border:1px solid rgba(220,38,38,0.3);">REQUIRED</span></div>
                        <div class="code-block">{ tx1.Memo }</div>
                    </div>
                }

                if tx1.Address != "" {
                    <div class="transaction-section text-center">
                        <button type="button" onclick={ toggleQRBridgeLeg1(tx1.Address) } class="qr-toggle-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M1 1h5v5H1zM1 10h5v5H1zM10 1h5v5h-5z"></path><path d="M10 10h1v1h-1zm1 1h1v1h-1zm1 1h1v1h-1zm1 0h1v-1h-1zm0-1h1V9h-1zm1-3h-1v1h1zm0 1h-1v1h1zm-2-1h-1v1h1zm0 1h-1v1h1z"></path></svg>
                            Show QR Code
                        </button>
                        <div class="mt-4" id="qr-bridge-leg1">
                            <img src={ "/generate?text=" + tx1.Address } alt="QR Code" class="mx-auto border-4 border-white rounded-lg hidden"/>
                        </div>
                    </div>
                }

                <div class="divider"></div>

                <div class="transaction-section">
                    <div class="section-label">CypherGoat ID</div>
                    <div class="cgid-value">
                        if tx1.CGID != "" {
                            <a href={ templ.URL("/transaction/" + tx1.CGID) } class="track-link">{ tx1.CGID }</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="bridge-main-card">
            <div class="transaction-card secondary-card">
                <div class="leg-label">Leg 2 <span class="auto-tag">Automatic</span></div>
                <h2 class="transaction-header">{ tx2.Provider } — XMR → { strings.ToUpper(tx2.Coin2) }</h2>

                <div class="transaction-section" style="margin-bottom:0.75rem;">
                    <div class="section-label">Expected Payout ≈</div>
                    <div class="section-value">{ FormatFloat(quote.Leg2.ReceiveAmount) } { strings.ToUpper(tx2.Coin2) }</div>
                </div>

                <div class="transaction-section" style="margin-bottom:0;">
                    <div class="section-label">CypherGoat ID</div>
                    <div class="cgid-value">
                        if tx2.CGID != "" {
                            <a href={ templ.URL("/transaction/" + tx2.CGID) } class="track-link">{ tx2.CGID }</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="warning-box">
            <strong style="color:#c7d2fe;">Only send to the Leg 1 address above.</strong> Leg 2 completes automatically once Leg 1's funds arrive — no separate deposit needed. Save both CypherGoat IDs for your records.
            if bridgeGroupID != "" {
                <div style="margin-top:0.5rem;opacity:0.75;">Route ID: { bridgeGroupID }</div>
            }
        </div>
    </div>

    <script>
    function toggleQR(containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        const img = container.querySelector('img');
        if (!img) return;
        img.classList.toggle('hidden');
    }
    </script>
}
@Footer(){}

}

script toggleQRBridgeLeg1(addr string) {
    toggleQR("qr-bridge-leg1");
}

// suppress unused import
var _ = fmt.Sprintf
