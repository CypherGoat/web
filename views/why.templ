package views

import "fmt"

templ WhyCG() {
	<style>
	.wc-shell {
		max-width: var(--cg-shell);
		margin: 0 auto;
		padding: var(--cg-section-gap) var(--cg-gutter) 0;
	}

	/* ── Header ──────────────────────────── */
	.wc-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: #8d95a5;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-bottom: 1.1rem;
	}

	.wc-kicker::before {
		content: "";
		width: 2.75rem;
		height: 1px;
		background: rgba(153, 161, 175, 0.24);
	}

	.wc-heading {
		margin: 0 0 0.75rem;
		color: #ffffff;
		font-size: clamp(2.4rem, 4vw, 3.5rem);
		line-height: 0.95;
		font-weight: 500;
		letter-spacing: -0.05em;
	}

	.wc-subheading {
		margin: 0 0 3rem;
		color: #8b95a7;
		font-size: 1rem;
		line-height: 1.75;
		max-width: 48rem;
	}

	/* ── Stat strip ───────────────────────── */
	.wc-stat-strip {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0;
		border: 1px solid rgba(255,255,255,0.06);
		border-radius: 18px;
		background: linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0.007)), #11151c;
		overflow: hidden;
		margin-bottom: 2.5rem;
		box-shadow: 0 20px 50px rgba(0,0,0,0.25);
	}

	.wc-strip-item {
		padding: 1.5rem 1.4rem;
		text-align: center;
		position: relative;
	}

	.wc-strip-item + .wc-strip-item::before {
		content: '';
		position: absolute;
		left: 0; top: 20%; bottom: 20%;
		width: 1px;
		background: rgba(255,255,255,0.06);
	}

	.wc-strip-label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #64748b;
		margin-bottom: 0.4rem;
	}

	.wc-strip-value {
		font-size: 2rem;
		font-weight: 700;
		color: #f3eee2;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	/* ── Section groups ───────────────────── */
	.wc-section {
		margin-bottom: 3rem;
	}

	.wc-section:last-child {
		margin-bottom: 0;
	}

	.wc-section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid rgba(255,255,255,0.06);
		padding-bottom: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.wc-section-head .wc-section-heading {
		margin: 0;
		border: 0;
		padding: 0;
	}

	.wc-head-link {
		font-size: 0.78rem;
		font-weight: 600;
		color: #8b95a7;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s;
	}

	.wc-head-link:hover { color: #cbd5e1; }

	.wc-card-grid-4, .wc-card-grid-3, .wc-card-grid-2 {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.wc-card-accent {
		border-color: rgba(99,102,241,0.15);
	}

	.wc-card-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin-top: 0.85rem;
	}

	.wc-link {
		font-size: 0.8rem;
		font-weight: 600;
		color: #a5b4fc;
		text-decoration: none;
		white-space: nowrap;
		opacity: 0.85;
		transition: opacity 0.15s;
	}

	.wc-link:hover { opacity: 1; }

	.wc-inline-link {
		color: #cbd5e1;
		text-decoration: underline;
		text-decoration-color: rgba(203,213,225,0.3);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}

	.wc-inline-link:hover { text-decoration-color: rgba(203,213,225,0.8); }

	.wc-section-heading {
		margin: 0 0 1.25rem;
		color: #ffffff;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		border-bottom: 1px solid rgba(255,255,255,0.06);
		padding-bottom: 0.75rem;
	}

	.wc-card-grid-4 {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.85rem;
	}

	.wc-card-grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.85rem;
	}

	.wc-card-grid-2 {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.85rem;
	}

	.wc-card {
		padding: 1.5rem 1.5rem;
		border-radius: 18px;
		border: 1px solid rgba(255,255,255,0.06);
		background: linear-gradient(180deg, rgba(255,255,255,0.016), rgba(255,255,255,0.006)), #11151c;
		box-shadow: 0 16px 42px rgba(0,0,0,0.22);
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.wc-card:hover {
		border-color: rgba(255,255,255,0.1);
		box-shadow: 0 22px 56px rgba(0,0,0,0.28);
	}

	.wc-card-title {
		margin: 0 0 0.5rem;
		color: #e2e8f0;
		font-size: 0.97rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.wc-card-body {
		margin: 0;
		color: #8b95a7;
		font-size: 0.9rem;
		line-height: 1.7;
	}

	/* ── Responsive ───────────────────────── */
	@media (max-width: 860px) {
		.wc-card-grid-3 { grid-template-columns: 1fr 1fr; }
		.wc-card-grid-4 { grid-template-columns: 1fr 1fr; }
	}

	@media (max-width: 600px) {
		.wc-shell { padding: var(--cg-section-gap) var(--cg-gutter) 0; }
		.wc-stat-strip { grid-template-columns: 1fr 1fr; border-radius: 14px; }
		.wc-card-grid-4, .wc-card-grid-3, .wc-card-grid-2 { grid-template-columns: 1fr; }
	}
	</style>

	<section id="why-section" class="wc-shell text-white hide-on-swap" aria-labelledby="why-heading">

		<!-- Header -->
		<p class="wc-kicker">Why CypherGoat</p>
		<h2 id="why-heading" class="wc-heading">Built differently, on purpose.</h2>
		<p class="wc-subheading">Most swap services optimize for simplicity. We optimize for outcome, meaning better rates, real user protections, and zero custody of your funds at any point.</p>

		<!-- Stat strip -->
		<dl class="wc-stat-strip">
			<div class="wc-strip-item">
				<dt class="wc-strip-label">Exchange partners</dt>
				<dd class="wc-strip-value">{ fmt.Sprintf("%d", len(ExchangesList)) }</dd>
			</div>
			<div class="wc-strip-item">
				<dt class="wc-strip-label">Supported assets</dt>
				<dd class="wc-strip-value">100+</dd>
			</div>
		</dl>

		<!-- Core principles -->
		<section class="wc-section" aria-labelledby="core-principles-heading">
			<h3 id="core-principles-heading" class="wc-section-heading">Core principles</h3>
			<ul class="wc-card-grid-4">
				<li class="wc-card">
					<h4 class="wc-card-title">Non-custodial, always</h4>
					<p class="wc-card-body">We never hold your funds. Swaps route directly between you and the exchange. CypherGoat is a router, not an intermediary.</p>
				</li>
				<li class="wc-card wc-card-accent">
					<h4 class="wc-card-title">SafeRoute</h4>
					<p class="wc-card-body">On larger swaps, a single exchange can't always fill your order at the quoted rate. SafeRoute splits it across multiple partners simultaneously — bigger swap, better rate, handled automatically.</p>
					<div class="wc-card-links"><a href="/saferoute" class="wc-link">How SafeRoute works →</a></div>
				</li>
				<li class="wc-card">
					<h4 class="wc-card-title">No account required</h4>
					<p class="wc-card-body">No email, no sign-up and no profile on our interface, which also runs with or without JavaScript. Partner exchanges apply their own account and verification policies.</p>
				</li>
				<li class="wc-card">
					<h4 class="wc-card-title">Broad asset coverage</h4>
					<p class="wc-card-body">Over 100 assets across every major network, including pairs that most aggregators do not route at all. If a partner can fill it, we will quote it.</p>
				</li>
			</ul>
		</section>

		<!-- Trust & transparency -->
		<section class="wc-section" aria-labelledby="trust-transparency-heading">
			<div class="wc-section-head">
				<h3 id="trust-transparency-heading" class="wc-section-heading">Trust &amp; transparency</h3>
				<a href="/transparency" class="wc-head-link">View transparency report →</a>
			</div>
			<ul class="wc-card-grid-2">
				<li class="wc-card">
					<h4 class="wc-card-title">Partner due diligence</h4>
					<p class="wc-card-body">Every provider is assessed before it is listed and reviewed on an ongoing basis. Our <a href="/aml-policy" class="wc-inline-link">compliance and AML policy</a> sets out exactly what we check and what gets a partner removed.</p>
				</li>
				<li class="wc-card">
					<h4 class="wc-card-title">Open source web UI</h4>
					<p class="wc-card-body">Our frontend is open source. You can see exactly what the interface does and how it works — <a href="https://github.com/CypherGoat/web" target="_blank" rel="noopener" class="wc-inline-link">view source on GitHub</a>.</p>
				</li>
			</ul>
		</section>

		<!-- For developers -->
		<section class="wc-section" aria-labelledby="for-developers-heading">
			<h3 id="for-developers-heading" class="wc-section-heading">For developers</h3>
			<ul class="wc-card-grid-2">
				<li class="wc-card">
					<h4 class="wc-card-title">Full public API</h4>
					<p class="wc-card-body">Every endpoint we use internally is available to you. Build wallets, tools, and integrations on top of CypherGoat.</p>
					<div class="wc-card-links">
						<a href="https://developer.cyphergoat.com" target="_blank" rel="noopener" class="wc-link">Get an API key →</a>
						<a href="https://api.cyphergoat.com" target="_blank" rel="noopener" class="wc-link">Read the docs →</a>
					</div>
				</li>
				<li class="wc-card">
					<h4 class="wc-card-title">MCP server</h4>
					<p class="wc-card-body">Native AI agent support via our live MCP server. The only swap aggregator you can wire directly into an AI workflow.</p>
					<div class="wc-card-links">
						<a href="/mcp" class="wc-link">Set up the MCP server →</a>
						<a href="https://www.youtube.com/watch?v=9sRwtqcKBMc" target="_blank" rel="noopener" class="wc-link">Watch the demo →</a>
					</div>
				</li>
			</ul>
		</section>

	</section>
}
